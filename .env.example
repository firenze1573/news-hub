# Gmail 示例。请勿把真实密码提交到 Git。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_TO=your-private-email@example.com
EMAIL_FROM=
EMAIL_FROM_NAME=每日重要新闻
EMAIL_SUBJECT_PREFIX=每日重要新闻
TRANSLATION_EMAIL=your-contact-email@example.com
TRANSLATION_TIMEOUT=20

# 本地测试时设为 true，只生成 output/preview.html，不发送邮件。
DRY_RUN=true
NEWS_MAX_ITEMS=12
NEWS_LOOKBACK_HOURS=36
NEWS_MAX_SELECTED_PER_SOURCE=3
NEWS_MAX_SELECTED_PER_CATEGORY=3
NEWS_TIMEZONE=Asia/Tokyo
